# 复制为 .env 后再改：cp .env.example .env
# docker compose 会自动读取项目根目录的 .env

# ---- 数据库 ----
MYSQL_ROOT_PASSWORD=123456
# 用于 go-zero cache 的连接密码，compose 里 Redis 默认没有密码
REDIS_PASSWORD=

# ---- 用户服务 ----
# JWT 签名密钥：泄露等于所有人可伪造 token，生产环境必须替换
JWT_SECRET=please-change-me-jwt-secret
# 密码哈希盐
USER_SALT=please-change-me-user-salt

# ---- 服务间内部调用 ----
# file-api 与 storage-api 共用；为空时 storage-api 会拒绝所有内部请求
INTERNAL_TOKEN=please-change-me-internal-token

# ---- 对外地址 ----
# 用于拼出分享链接（客户端能访问到的 file-api 地址）
PUBLIC_BASE_URL=http://127.0.0.1:8001

# ---- MinIO ----
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=cloud-drive

# ---- Grafana（仅 observability profile 使用）----
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
