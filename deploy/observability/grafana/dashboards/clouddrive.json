{
  "title": "CloudDrive Overview",
  "uid": "clouddrive-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "type": "stat",
      "title": "HTTP QPS",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_code_total[1m]))",
          "legendFormat": "qps"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "HTTP 5xx 比例",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_server_requests_code_total{code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_code_total[5m])), 0.000001)",
          "legendFormat": "5xx"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] }
    },
    {
      "type": "stat",
      "title": "活跃上传任务",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "clouddrive_upload_active_tasks",
          "legendFormat": "active"
        }
      ]
    },
    {
      "type": "stat",
      "title": "对象清理积压",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        {
          "expr": "clouddrive_storage_object_gc_backlog",
          "legendFormat": "deleting"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "HTTP P95 延迟（按路径）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, path) (rate(http_server_requests_duration_ms_bucket[5m])))",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "RPC P95 延迟（按方法）",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, method) (rate(rpc_server_requests_duration_ms_bucket[5m])))",
          "legendFormat": "{{method}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "上传/下载吞吐（字节/秒）",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        {
          "expr": "rate(clouddrive_upload_bytes_total[5m])",
          "legendFormat": "upload"
        },
        {
          "expr": "rate(clouddrive_download_bytes_total[5m])",
          "legendFormat": "download"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "上传完成结果",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        {
          "expr": "sum by (result) (rate(clouddrive_upload_completed_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "配额拒绝次数",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "rate(clouddrive_quota_rejected_total[5m])",
          "legendFormat": "rejected"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "事件循环耗时 / Goroutine（进程视角）",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "targets": [
        {
          "expr": "go_goroutines{job=~\"clouddrive-.*\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
